{
  "name": "remotedesk-client",
  "productName": "RemoteDesk",
  "version": "0.2.0",
  "private": true,
  "description": "RemoteDesk desktop client (Windows / macOS / Linux)",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "lint": "eslint ."
  },
  "devDependencies": {
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.10.0"
  },
  "build": {
    "appId": "ai.devin.remotedesk.client",
    "productName": "RemoteDesk",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "setup.js",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "RemoteDeskClient-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RemoteDesk"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "RemoteDeskClient-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "artifactName": "RemoteDeskClient-${version}-${arch}.${ext}",
      "category": "Network"
    }
  }
}
